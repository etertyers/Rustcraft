// Every block, named as in modern Minecraft Java Edition (the namespace,
// minecraft:, is left out). A block's runtime ID is its place in this
// list; build.rs turns the names into constants (world::blocks::OAK_LOG),
// and saves store names, so entries can be added anywhere. The table from
// v1.0's numeric IDs to these names is assets/data/legacy.ron.
//
// Fields (only name and hardness are required):
//   hardness  1.0.0 mining hardness; negative = unbreakable
//   props     block state properties (Prop in src/world/props.rs), e.g.
//             [Facing, Half, StairsShape, Waterlogged]
//   defaults  default values unlike Minecraft's usual ones ("lit=true")
//   placed    values a block placed by a player gets ("persistent=true")
//   item      whether the block has an item (default true)
//   item_texture  name in assets/textures/items/ its item shows instead of
//             the block drawn as an icon (doors, beds, sugar cane...)
//   stack     most of its item in a stack (default 64)
//   shape     model, default Cube (see Shape in src/world/block.rs)
//   layer     Opaque (default), Cutout or Translucent
//   solid     entities collide with it (default true)
//   light     light emitted, 0-15 (default 0)
//   cull_same hide faces between two of this block (glass, water)
//   textures  names in assets/textures/blocks/ (without .png), per face. The
//             most specific field wins: north/south/east/west, then
//             top/bottom, then end (top + bottom) or side (four sides), then
//             all. A block with a "front" puts it on south; with placement
//             Facing it's turned the way it faces. Leave out for blocks
//             that draw nothing.
//   speed_factor, jump_factor  walking and jumping scaled while in or on it
//             (default 1; soul sand and honey 0.4, honey jumps 0.5)
//   climbable ladders and vines: the player climbs them
//   bouncy    landing on it bounces (slime)
//   slipperiness  ground friction, 0.6 default (ice 0.98, blue ice 0.989, slime 0.8)
//   tint      None (default), GrassTop, Grass, Foliage or Fixed(0xRRGGBB)
//   variants  [(condition, (textures, tint, light))]: overrides for the
//             states meeting a condition such as "age=7" or
//             "shape=north_east|south_east", applied in order; textures
//             replace only the faces they name
//   tool      tool that mines it fast: Pickaxe, Shovel or Axe
//   harvest   tool needed to drop anything: (tools: [...], tier: Wood)
//   placement how placing picks the state (Placement in src/world/block.rs):
//             Plain (default), Torch(wall: block), Facing (front toward
//             the player), Look, LookClockwise, Axis (logs), Bed, Door,
//             Slab, Stairs, Trapdoor, Wall (ladders), Attached (levers,
//             buttons), Vine, Layers (snow), Rail or Tall (two-block plants)
//   acts_as   a block whose coded behavior it shares: wooden buttons and
//             plates act as oak's, leaves as oak leaves, saplings as the
//             oak sapling, small flowers as the poppy
//   activate  what right-clicking it does: Crafting (opens a 3×3 grid),
//             Chest or Furnace (opens its slots), Bed (sleeps), Door
//             (opens and closes both halves; iron doors have none, needing
//             redstone) or Open (opens and closes a trapdoor or gate)
//   falls     falls when nothing's under it after a block update (sand)
//   hardens   the block it turns into touching water (concrete powder)
//   fluid     Water or Lava for liquids (swimming, fog, slower mining)
//   burns     (encourage, catch): how readily fire spreads beside it and
//             how readily it burns away (modern FireBlock values)
//   drops     Itself (default: its item, two from a double slab), Nothing,
//             All([...]) every drop that rolls, or OneOf([...]) the first
//             that rolls. A drop is (item, min, max, chance, when, tool,
//             not_tool), `when` a condition on the broken block's state.
//
// Gameplay values (hardness, drops, stack sizes) are still 1.0.0's; v1.1
// milestones switch them to modern ones as they reach each system.
#![enable(implicit_some)]
[
    (name: "air", hardness: 0.0, item: false, drops: Nothing, replaceable: true, shape: None, solid: false),
    (name: "stone", hardness: 1.5, tool: Pickaxe, harvest: (tools: [Pickaxe]), drops: All([(item: "cobblestone")]), textures: (all: "stone")),
    (name: "grass_block", hardness: 0.6, props: [Snowy], tool: Shovel, drops: All([(item: "dirt")]), textures: (all: "dirt", top: "grass_block_top", side: "grass_block_side"), tint: GrassTop,
        variants: [("snowy=true", (textures: (top: "snow", side: "grass_block_snow"), tint: Some(None)))]),
    (name: "dirt", hardness: 0.5, tool: Shovel, textures: (all: "dirt")),
    (name: "cobblestone", hardness: 2.0, tool: Pickaxe, harvest: (tools: [Pickaxe]), textures: (all: "cobblestone")),
    (name: "oak_planks", hardness: 2.0, burns: (encourage: 5, catch: 20), tool: Axe, textures: (all: "oak_planks")),
    (name: "oak_sapling", hardness: 0.0, props: [Stage], needs_ground: true, shape: Cross, layer: Cutout, solid: false, textures: (all: "oak_sapling")),
    (name: "spruce_sapling", hardness: 0.0, props: [Stage], acts_as: "oak_sapling", needs_ground: true, shape: Cross, layer: Cutout, solid: false, textures: (all: "spruce_sapling")),
    (name: "birch_sapling", hardness: 0.0, props: [Stage], acts_as: "oak_sapling", needs_ground: true, shape: Cross, layer: Cutout, solid: false, textures: (all: "birch_sapling")),
    (name: "bedrock", hardness: -1.0, textures: (all: "bedrock")),
    // Level 0 is a source, 1-7 flowing further from one, 8 and up falling.
    (name: "water", hardness: 100.0, props: [Level], item: false, fluid: Water, drops: Nothing, opacity: 3, replaceable: true, shape: Liquid, layer: Translucent, solid: false, cull_same: true, textures: (end: "water_still", side: "water_flow")),
    (name: "lava", hardness: 100.0, props: [Level], item: false, fluid: Lava, drops: Nothing, opacity: 15, replaceable: true, shape: Liquid, solid: false, light: 15, cull_same: true, textures: (end: "lava_still", side: "lava_flow")),
    (name: "sand", hardness: 0.5, falls: true, tool: Shovel, textures: (all: "sand")),
    (name: "gravel", hardness: 0.6, falls: true, tool: Shovel, drops: OneOf([(item: "flint", chance: 0.1), (item: "gravel")]), textures: (all: "gravel")),
    (name: "gold_ore", hardness: 3.0, tool: Pickaxe, harvest: (tools: [Pickaxe], tier: Iron), textures: (all: "gold_ore")),
    (name: "iron_ore", hardness: 3.0, tool: Pickaxe, harvest: (tools: [Pickaxe], tier: Stone), textures: (all: "iron_ore")),
    (name: "coal_ore", hardness: 3.0, tool: Pickaxe, harvest: (tools: [Pickaxe]), drops: All([(item: "coal")]), textures: (all: "coal_ore")),
    (name: "oak_log", hardness: 2.0, props: [Axis], placement: Axis, burns: (encourage: 5, catch: 5), tool: Axe, textures: (end: "oak_log_top", side: "oak_log")),
    (name: "spruce_log", hardness: 2.0, props: [Axis], placement: Axis, burns: (encourage: 5, catch: 5), tool: Axe, textures: (end: "spruce_log_top", side: "spruce_log")),
    (name: "birch_log", hardness: 2.0, props: [Axis], placement: Axis, burns: (encourage: 5, catch: 5), tool: Axe, textures: (end: "birch_log_top", side: "birch_log")),
    // There's no leaf decay yet, so `distance` stays at its default.
    // 1.0.0 colors spruce and birch leaves with fixed colors instead of the biome.
    (name: "oak_leaves", hardness: 0.2, props: [Distance, Persistent, Waterlogged], placed: "persistent=true", burns: (encourage: 30, catch: 60), drops: OneOf([(item: "oak_leaves", tool: Shears), (item: "oak_sapling", chance: 0.05, not_tool: Shears)]), opacity: 1, layer: Cutout, textures: (all: "oak_leaves"), tint: Foliage),
    (name: "spruce_leaves", hardness: 0.2, props: [Distance, Persistent, Waterlogged], placed: "persistent=true", acts_as: "oak_leaves", burns: (encourage: 30, catch: 60), drops: OneOf([(item: "spruce_leaves", tool: Shears), (item: "spruce_sapling", chance: 0.05, not_tool: Shears)]), opacity: 1, layer: Cutout, textures: (all: "spruce_leaves"), tint: Fixed(0x619961)),
    (name: "birch_leaves", hardness: 0.2, props: [Distance, Persistent, Waterlogged], placed: "persistent=true", acts_as: "oak_leaves", burns: (encourage: 30, catch: 60), drops: OneOf([(item: "birch_leaves", tool: Shears), (item: "birch_sapling", chance: 0.05, not_tool: Shears)]), opacity: 1, layer: Cutout, textures: (all: "birch_leaves"), tint: Fixed(0x80A755)),
    (name: "sponge", hardness: 0.6, textures: (all: "sponge")),
    (name: "glass", hardness: 0.3, drops: Nothing, layer: Translucent, cull_same: true, textures: (all: "glass")),
    (name: "lapis_ore", hardness: 3.0, tool: Pickaxe, harvest: (tools: [Pickaxe], tier: Stone), drops: All([(item: "lapis_lazuli", min: 4, max: 8)]), textures: (all: "lapis_ore")),
    (name: "lapis_block", hardness: 3.0, tool: Pickaxe, harvest: (tools: [Pickaxe], tier: Stone), textures: (all: "lapis_block")),
    (name: "dispenser", hardness: 3.5, props: [FacingAll, Triggered], placement: Facing, activate: Dispenser, tool: Pickaxe, harvest: (tools: [Pickaxe]), textures: (end: "furnace_top", side: "furnace_side", south: "dispenser_front"),
        variants: [
