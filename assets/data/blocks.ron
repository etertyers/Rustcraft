    (name: "fern", hardness: 0.0, burns: (encourage: 60, catch: 100), drops: All([(item: "wheat_seeds", chance: 0.125)]), replaceable: true, needs_ground: true, shape: Cross, layer: Cutout, solid: false, textures: (all: "fern"), tint: Grass),
