// Textures that older packs (and Kenzo's) keep on a shared sheet, as
// "name": ("sheet", (x, y, width, height)) in the sheet's 128-pixel
// units; a bigger sheet scales the rectangle. A layer that has the
// texture as its own file uses that instead.
{
    "particle/critical_hit": ("particle/particles", (8, 32, 8, 8)),
    "particle/sweep_0": ("particle/particles", (0, 112, 16, 16)),
    "particle/sweep_1": ("particle/particles", (32, 112, 16, 16)),
    "particle/sweep_2": ("particle/particles", (64, 112, 16, 16)),
    "particle/sweep_3": ("particle/particles", (96, 112, 16, 16)),
    // The experience orb sheet is 64 pixels wide, 4×4 pictures, small to big.
    "entity/xp_orb_0": ("entity/experience_orb", (0, 0, 32, 32)),
    "entity/xp_orb_1": ("entity/experience_orb", (32, 0, 32, 32)),
    "entity/xp_orb_2": ("entity/experience_orb", (64, 0, 32, 32)),
    "entity/xp_orb_3": ("entity/experience_orb", (96, 0, 32, 32)),
    "entity/xp_orb_4": ("entity/experience_orb", (0, 32, 32, 32)),
    "entity/xp_orb_5": ("entity/experience_orb", (32, 32, 32, 32)),
    "entity/xp_orb_6": ("entity/experience_orb", (64, 32, 32, 32)),
    "entity/xp_orb_7": ("entity/experience_orb", (96, 32, 32, 32)),
    "entity/xp_orb_8": ("entity/experience_orb", (0, 64, 32, 32)),
    "entity/xp_orb_9": ("entity/experience_orb", (32, 64, 32, 32)),
    "entity/xp_orb_10": ("entity/experience_orb", (64, 64, 32, 32)),
}
