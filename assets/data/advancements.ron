// Advancements (M29): five tabs of goals, each a list of criteria the game's
// events tick off (see src/advancements.rs for what a trigger is). Titles
// and descriptions are modern Minecraft's where the thing exists here; the
// tree is laid out from the parents, so the order here is only the order
// the nodes of one parent are drawn in.
//
// Left out because nothing here makes them happen: bees,
// goats, trims, the Wither, ocean monuments and the like.
#![enable(implicit_some)]
[
    (id: "story/root", tab: Minecraft, title: "Minecraft", description: "The heart and story of the game", icon: "grass_block", frame: Task, criteria: [("start", Always)]),
    (id: "story/mine_stone", tab: Minecraft, parent: "story/root", title: "Stone Age", description: "Mine stone with your new pickaxe", icon: "cobblestone", frame: Task, criteria: [("cobblestone", Have("cobblestone"))]),
    (id: "story/upgrade_tools", tab: Minecraft, parent: "story/mine_stone", title: "Getting an Upgrade", description: "Construct a better pickaxe", icon: "stone_pickaxe", frame: Task, criteria: [("stone_pickaxe", Have("stone_pickaxe"))]),
    (id: "story/smelt_iron", tab: Minecraft, parent: "story/upgrade_tools", title: "Acquire Hardware", description: "Smelt an iron ingot", icon: "iron_ingot", frame: Task, criteria: [("iron_ingot", Have("iron_ingot"))]),
    (id: "story/iron_tools", tab: Minecraft, parent: "story/smelt_iron", title: "Isn't It Iron Pick", description: "Upgrade your pickaxe", icon: "iron_pickaxe", frame: Task, criteria: [("iron_pickaxe", Have("iron_pickaxe"))]),
    (id: "story/mine_diamond", tab: Minecraft, parent: "story/iron_tools", title: "Diamonds!", description: "Acquire diamonds", icon: "diamond", frame: Task, criteria: [("diamond", Have("diamond"))]),
    (id: "story/shiny_gear", tab: Minecraft, parent: "story/mine_diamond", title: "Cover Me with Diamonds", description: "Diamond armor saves lives", icon: "diamond_chestplate", frame: Challenge, criteria: [("diamond_chestplate", Have("diamond_chestplate"))]),
    (id: "story/enchant_item", tab: Minecraft, parent: "story/mine_diamond", title: "Enchanter", description: "Enchant an item at an Enchanting Table", icon: "enchanting_table", frame: Task, criteria: [("enchanted", Used("enchant"))]),
    (id: "story/form_obsidian", tab: Minecraft, parent: "story/iron_tools", title: "Ice Bucket Challenge", description: "Obtain a block of obsidian", icon: "obsidian", frame: Task, criteria: [("obsidian", Have("obsidian"))]),
    (id: "story/lava_bucket", tab: Minecraft, parent: "story/smelt_iron", title: "Hot Stuff", description: "Fill a bucket with lava", icon: "lava_bucket", frame: Task, criteria: [("lava_bucket", Have("lava_bucket"))]),
    (id: "story/obtain_armor", tab: Minecraft, parent: "story/smelt_iron", title: "Suit Up", description: "Protect yourself with a piece of iron armor", icon: "iron_chestplate", frame: Task, criteria: [("any", Have("iron_chestplate"))]),
    (id: "story/deflect_arrow", tab: Minecraft, parent: "story/obtain_armor", title: "Not Today, Thank You", description: "Block an arrow with a shield", icon: "shield", frame: Task, criteria: [("shield", Have("shield"))]),
    (id: "story/enter_the_nether", tab: Minecraft, parent: "story/form_obsidian", title: "We Need to Go Deeper", description: "Build, light and enter a Nether Portal", icon: "flint_and_steel", frame: Task, criteria: [("nether", Dimension("the_nether"))]),
    (id: "story/follow_ender_eye", tab: Minecraft, parent: "story/enter_the_nether", title: "Eye Spy", description: "Enter a Stronghold", icon: "ender_eye", frame: Task, criteria: [("stronghold", Structure("stronghold"))]),
    (id: "story/enter_the_end", tab: Minecraft, parent: "story/follow_ender_eye", title: "The End?", description: "Enter the End", icon: "end_stone", frame: Task, criteria: [("end", Dimension("the_end"))]),
    (id: "nether/root", tab: Nether, title: "Nether", description: "Bring summer clothes", icon: "red_nether_bricks", frame: Task, criteria: [("nether", Dimension("the_nether"))]),
    (id: "nether/find_fortress", tab: Nether, parent: "nether/root", title: "A Terrible Fortress", description: "Break your way into a Nether Fortress", icon: "nether_bricks", frame: Task, criteria: [("fortress", Structure("nether fortress"))]),
    (id: "nether/obtain_blaze_rod", tab: Nether, parent: "nether/find_fortress", title: "Into Fire", description: "Relieve a Blaze of its rod", icon: "blaze_rod", frame: Task, criteria: [("blaze_rod", Have("blaze_rod"))]),
    (id: "nether/brew_potion", tab: Nether, parent: "nether/obtain_blaze_rod", title: "Local Brewery", description: "Brew a potion", icon: "brewing_stand", frame: Task, criteria: [("brewed", Used("brew"))]),
    (id: "nether/find_bastion", tab: Nether, parent: "nether/root", title: "Those Were the Days", description: "Enter a Bastion Remnant", icon: "polished_blackstone_bricks", frame: Task, criteria: [("bastion", Structure("bastion remnant"))]),
    (id: "nether/obtain_ancient_debris", tab: Nether, parent: "nether/root", title: "Hidden in the Depths", description: "Obtain Ancient Debris", icon: "ancient_debris", frame: Task, criteria: [("ancient_debris", Have("ancient_debris"))]),
    (id: "nether/netherite_armor", tab: Nether, parent: "nether/obtain_ancient_debris", title: "Cover Me in Debris", description: "Get a full suit of Netherite armor", icon: "netherite_chestplate", frame: Challenge, criteria: [("helmet", Have("netherite_helmet")), ("chest", Have("netherite_chestplate")), ("legs", Have("netherite_leggings")), ("boots", Have("netherite_boots"))]),
    (id: "nether/return_to_sender", tab: Nether, parent: "nether/root", title: "Return to Sender", description: "Destroy a Ghast", icon: "ghast_tear", frame: Challenge, criteria: [("ghast", Killed("ghast"))]),
    (id: "nether/get_wither_skull", tab: Nether, parent: "nether/find_fortress", title: "Spooky Scary Skeleton", description: "Obtain a Wither Skeleton's skull", icon: "wither_skeleton_skull", frame: Challenge, criteria: [("wither_skeleton_skull", Have("wither_skeleton_skull"))]),
    (id: "nether/obtain_crying_obsidian", tab: Nether, parent: "nether/root", title: "Who is Cutting Onions?", description: "Obtain Crying Obsidian", icon: "crying_obsidian", frame: Task, criteria: [("crying_obsidian", Have("crying_obsidian"))]),
    (id: "nether/ride_strider", tab: Nether, parent: "nether/root", title: "This Boat Has Legs", description: "Ride a Strider with a Warped Fungus on a Stick", icon: "warped_fungus_on_a_stick", frame: Task, criteria: [("warped_fungus_on_a_stick", Have("warped_fungus_on_a_stick"))]),
    (id: "end/root", tab: End, title: "The End", description: "Or the beginning?", icon: "end_stone", frame: Task, criteria: [("end", Dimension("the_end"))]),
    (id: "end/kill_dragon", tab: End, parent: "end/root", title: "Free the End", description: "Good luck", icon: "dragon_egg", frame: Task, criteria: [("dragon", Used("kill_dragon"))]),
    (id: "end/dragon_egg", tab: End, parent: "end/kill_dragon", title: "The Next Generation", description: "Hold the Dragon Egg", icon: "dragon_egg", frame: Goal, criteria: [("dragon_egg", Have("dragon_egg"))]),
    (id: "end/enter_end_gateway", tab: End, parent: "end/kill_dragon", title: "Remote Getaway", description: "Escape the island", icon: "ender_pearl", frame: Task, criteria: [("gateway", Used("gateway"))]),
    (id: "end/find_end_city", tab: End, parent: "end/enter_end_gateway", title: "The City at the End of the Game", description: "Go on in, what could happen?", icon: "purpur_block", frame: Task, criteria: [("city", Structure("end city"))]),
    (id: "end/elytra", tab: End, parent: "end/find_end_city", title: "Sky's the Limit", description: "Find Elytra", icon: "elytra", frame: Goal, criteria: [("elytra", Have("elytra"))]),
    (id: "end/levitate", tab: End, parent: "end/find_end_city", title: "Great View From Up Here", description: "Levitate up 50 blocks from the attacks of a Shulker", icon: "shulker_shell", frame: Challenge, criteria: [("levitated", Used("levitate"))]),
    (id: "end/shulker_box", tab: End, parent: "end/find_end_city", title: "Shulker Boxes", description: "Make a Shulker Box", icon: "shulker_box", frame: Task, criteria: [("shulker_box", Have("shulker_box"))]),
    (id: "adventure/root", tab: Adventure, title: "Adventure", description: "Adventure, exploration and combat", icon: "compass", frame: Task, criteria: [("fight", Killed("*"))]),
    (id: "adventure/kill_a_mob", tab: Adventure, parent: "adventure/root", title: "Monster Hunter", description: "Kill any hostile monster", icon: "iron_sword", frame: Task, criteria: [("monster", Killed("*hostile"))]),
    (id: "adventure/shoot_arrow", tab: Adventure, parent: "adventure/kill_a_mob", title: "Take Aim", description: "Shoot something with an arrow", icon: "bow", frame: Task, criteria: [("shot", Used("shoot"))]),
    (id: "adventure/trade", tab: Adventure, parent: "adventure/root", title: "What a Deal!", description: "Successfully trade with a Villager", icon: "emerald", frame: Task, criteria: [("traded", Used("trade"))]),
    (id: "adventure/sleep_in_bed", tab: Adventure, parent: "adventure/root", title: "Sweet Dreams", description: "Sleep in a bed to change your respawn point", icon: "red_bed", frame: Task, criteria: [("slept", Used("sleep"))]),
    (id: "adventure/kill_all_mobs", tab: Adventure, parent: "adventure/kill_a_mob", title: "Monsters Hunted", description: "Kill one of every hostile monster", icon: "diamond_sword", frame: Challenge, criteria: [("zombie", Killed("zombie")), ("skeleton", Killed("skeleton")), ("creeper", Killed("creeper")), ("spider", Killed("spider")), ("enderman", Killed("enderman")), ("witch", Killed("witch")), ("slime", Killed("slime")), ("drowned", Killed("drowned")), ("husk", Killed("husk")), ("stray", Killed("stray")), ("phantom", Killed("phantom")), ("blaze", Killed("blaze")), ("ghast", Killed("ghast")), ("wither_skeleton", Killed("wither_skeleton")), ("magma_cube", Killed("magma_cube")), ("zombified_piglin", Killed("zombified_piglin")), ("piglin", Killed("piglin")), ("hoglin", Killed("hoglin")), ("shulker", Killed("shulker")), ("silverfish", Killed("silverfish")), ("cave_spider", Killed("cave_spider"))]),
    (id: "adventure/adventuring_time", tab: Adventure, parent: "adventure/root", title: "Adventuring Time", description: "Discover every biome", icon: "diamond_boots", frame: Challenge, criteria: [("plains", Biome("plains")), ("forest", Biome("forest")), ("desert", Biome("desert")), ("beach", Biome("beach")), ("stony_shore", Biome("stony_shore")), ("river", Biome("river")), ("taiga", Biome("taiga")), ("snowy_plains", Biome("snowy_plains")), ("snowy_taiga", Biome("snowy_taiga")), ("ice_spikes", Biome("ice_spikes")), ("jungle", Biome("jungle")), ("bamboo_jungle", Biome("bamboo_jungle")), ("swamp", Biome("swamp")), ("mangrove_swamp", Biome("mangrove_swamp")), ("savanna", Biome("savanna")), ("badlands", Biome("badlands")), ("birch_forest", Biome("birch_forest")), ("dark_forest", Biome("dark_forest")), ("windswept_hills", Biome("windswept_hills")), ("meadow", Biome("meadow")), ("grove", Biome("grove")), ("snowy_slopes", Biome("snowy_slopes")), ("jagged_peaks", Biome("jagged_peaks")), ("frozen_peaks", Biome("frozen_peaks")), ("cherry_grove", Biome("cherry_grove")), ("mushroom_fields", Biome("mushroom_fields")), ("ocean", Biome("ocean")), ("deep_ocean", Biome("deep_ocean")), ("warm_ocean", Biome("warm_ocean")), ("frozen_ocean", Biome("frozen_ocean"))]),
    (id: "adventure/find_village", tab: Adventure, parent: "adventure/trade", title: "A Home with a View", description: "Find a village", icon: "oak_door", frame: Task, criteria: [("village", Structure("village"))]),
    (id: "adventure/dungeon", tab: Adventure, parent: "adventure/root", title: "Dungeon Crawler", description: "Enter a dungeon or a mineshaft", icon: "chest", frame: Task, criteria: [("dungeon", Structure("dungeon"))]),
    (id: "adventure/ride", tab: Adventure, parent: "adventure/root", title: "Hot Tourist Destinations", description: "Visit every Nether biome", icon: "netherrack", frame: Challenge, criteria: [("nether_wastes", Biome("nether_wastes")), ("crimson_forest", Biome("crimson_forest")), ("warped_forest", Biome("warped_forest")), ("soul_sand_valley", Biome("soul_sand_valley")), ("basalt_deltas", Biome("basalt_deltas"))]),
    (id: "adventure/glide", tab: Adventure, parent: "adventure/root", title: "Wings of Your Own", description: "Obtain a pair of elytra", icon: "elytra", frame: Goal, criteria: [("elytra", Have("elytra"))]),
    (id: "adventure/fishy_business", tab: Adventure, parent: "adventure/root", title: "Fishy Business", description: "Catch a fish", icon: "fishing_rod", frame: Task, criteria: [("fish", Used("fish_caught"))]),
    (id: "adventure/tactical_fishing", tab: Adventure, parent: "adventure/fishy_business", title: "Tactical Fishing", description: "Catch a fish... without a fishing rod!", icon: "cod_bucket", frame: Task, criteria: [("bucket", Used("fish_bucket"))]),
    (id: "husbandry/root", tab: Husbandry, title: "Husbandry", description: "The world is full of friends and food", icon: "hay_block", frame: Task, criteria: [("ate", Ate("*"))]),
    (id: "husbandry/plant_seed", tab: Husbandry, parent: "husbandry/root", title: "A Seedy Place", description: "Plant a seed and watch it grow", icon: "wheat_seeds", frame: Task, criteria: [("planted", Placed("wheat"))]),
    (id: "husbandry/tame_an_animal", tab: Husbandry, parent: "husbandry/root", title: "Best Friends Forever", description: "Tame an animal", icon: "bone", frame: Task, criteria: [("tamed", Used("tame"))]),
    (id: "husbandry/balanced_diet", tab: Husbandry, parent: "husbandry/root", title: "A Balanced Diet", description: "Eat everything that is edible, even if it's not good for you", icon: "apple", frame: Challenge, criteria: [("apple", Ate("apple")), ("mushroom_stew", Ate("mushroom_stew")), ("bread", Ate("bread")), ("porkchop", Ate("porkchop")), ("cooked_porkchop", Ate("cooked_porkchop")), ("golden_apple", Ate("golden_apple")), ("cooked_beef", Ate("cooked_beef")), ("beef", Ate("beef")), ("chicken", Ate("chicken")), ("cooked_chicken", Ate("cooked_chicken")), ("rotten_flesh", Ate("rotten_flesh")), ("spider_eye", Ate("spider_eye")), ("carrot", Ate("carrot")), ("golden_carrot", Ate("golden_carrot")), ("melon_slice", Ate("melon_slice")), ("cooked_cod", Ate("cooked_cod")), ("cooked_salmon", Ate("cooked_salmon")), ("cod", Ate("cod")), ("salmon", Ate("salmon")), ("mutton", Ate("mutton")), ("cooked_mutton", Ate("cooked_mutton")), ("rabbit", Ate("rabbit")), ("cooked_rabbit", Ate("cooked_rabbit")), ("pufferfish", Ate("pufferfish")), ("chorus_fruit", Ate("chorus_fruit"))]),
    (id: "husbandry/shear_sheep", tab: Husbandry, parent: "husbandry/plant_seed", title: "Shear Brilliance", description: "Shear a sheep", icon: "shears", frame: Task, criteria: [("sheared", Used("shear"))]),
    (id: "husbandry/make_a_cake", tab: Husbandry, parent: "husbandry/plant_seed", title: "The Cake is a Lie", description: "Craft a cake", icon: "cake", frame: Task, criteria: [("cake", Have("cake"))]),
    (id: "husbandry/bake_bread", tab: Husbandry, parent: "husbandry/plant_seed", title: "Bake Bread", description: "Make bread", icon: "bread", frame: Task, criteria: [("bread", Have("bread"))]),
    (id: "husbandry/obtain_netherite_hoe", tab: Husbandry, parent: "husbandry/bake_bread", title: "Serious Dedication", description: "Use a Netherite Ingot to upgrade a Hoe", icon: "netherite_hoe", frame: Challenge, criteria: [("netherite_hoe", Have("netherite_hoe"))]),
    (id: "husbandry/obtain_milk", tab: Husbandry, parent: "husbandry/tame_an_animal", title: "Got Milk?", description: "Fill a bucket with milk", icon: "milk_bucket", frame: Task, criteria: [("milk_bucket", Have("milk_bucket"))]),
]
