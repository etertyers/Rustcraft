// 1.0.0's recipes for everything in scope (CraftingManager, FurnaceRecipes
// and TileEntityFurnace.getItemBurnTime).
//
// Ingredients are (item: name) or (tag: name), a tag being one of the groups
// below (any log, any wool, as 1.0.0 matched any data value). Items are
// named as in modern Minecraft; the recipes themselves are still 1.0.0's.
// Shaped recipes fit anywhere in the grid and may be mirrored.
//
// Redstone, rails and minecarts (M19) and every wood (M21) use modern
// recipes; anything made of planks takes any planks.
//
// Left out, because their systems aren't in the game (see DECISIONS.md):
// boat, map, painting, cake (no milk), eye of ender. Enchanting (M22),
// the Nether's (M24, M25) and brewing's (M26) came with their milestones.
#![enable(implicit_some)]
(
    tags: {
        "logs": ["oak_log", "oak_wood", "stripped_oak_log", "stripped_oak_wood", "spruce_log", "spruce_wood", "stripped_spruce_log", "stripped_spruce_wood", "birch_log", "birch_wood", "stripped_birch_log", "stripped_birch_wood", "jungle_log", "jungle_wood", "stripped_jungle_log", "stripped_jungle_wood", "acacia_log", "acacia_wood", "stripped_acacia_log", "stripped_acacia_wood", "dark_oak_log", "dark_oak_wood", "stripped_dark_oak_log", "stripped_dark_oak_wood", "mangrove_log", "mangrove_wood", "stripped_mangrove_log", "stripped_mangrove_wood", "cherry_log", "cherry_wood", "stripped_cherry_log", "stripped_cherry_wood"],
        "planks": ["oak_planks", "spruce_planks", "birch_planks", "jungle_planks", "acacia_planks", "dark_oak_planks", "mangrove_planks", "cherry_planks", "bamboo_planks", "crimson_planks", "warped_planks"],
        // Nether wood doesn't burn, so it isn't fuel.
        "burnable_planks": ["oak_planks", "spruce_planks", "birch_planks", "jungle_planks", "acacia_planks", "dark_oak_planks", "mangrove_planks", "cherry_planks", "bamboo_planks"],
        "wooden_slabs": ["oak_slab", "spruce_slab", "birch_slab", "jungle_slab", "acacia_slab", "dark_oak_slab", "mangrove_slab", "cherry_slab", "bamboo_slab", "crimson_slab", "warped_slab"],
        "burnable_slabs": ["oak_slab", "spruce_slab", "birch_slab", "jungle_slab", "acacia_slab", "dark_oak_slab", "mangrove_slab", "cherry_slab", "bamboo_slab"],
        "oak_logs": ["oak_log", "oak_wood", "stripped_oak_log", "stripped_oak_wood"],
        "spruce_logs": ["spruce_log", "spruce_wood", "stripped_spruce_log", "stripped_spruce_wood"],
        "birch_logs": ["birch_log", "birch_wood", "stripped_birch_log", "stripped_birch_wood"],
        "jungle_logs": ["jungle_log", "jungle_wood", "stripped_jungle_log", "stripped_jungle_wood"],
        "acacia_logs": ["acacia_log", "acacia_wood", "stripped_acacia_log", "stripped_acacia_wood"],
        "dark_oak_logs": ["dark_oak_log", "dark_oak_wood", "stripped_dark_oak_log", "stripped_dark_oak_wood"],
        "mangrove_logs": ["mangrove_log", "mangrove_wood", "stripped_mangrove_log", "stripped_mangrove_wood"],
        "cherry_logs": ["cherry_log", "cherry_wood", "stripped_cherry_log", "stripped_cherry_wood"],
        "crimson_stems": ["crimson_stem", "crimson_hyphae", "stripped_crimson_stem", "stripped_crimson_hyphae"],
        "warped_stems": ["warped_stem", "warped_hyphae", "stripped_warped_stem", "stripped_warped_hyphae"],
        "soul_fire_base": ["soul_sand", "soul_soil"],
        "bamboo_blocks": ["bamboo_block", "stripped_bamboo_block"],
        "wool": ["white_wool", "orange_wool", "magenta_wool", "light_blue_wool", "yellow_wool", "lime_wool", "pink_wool", "gray_wool", "light_gray_wool", "cyan_wool", "purple_wool", "blue_wool", "brown_wool", "green_wool", "red_wool", "black_wool"],
    },
    shaped: [
        // Wood and basics
        (result: (item: "stick", count: 4), pattern: ["#", "#"], key: {'#': (tag: "planks")}),  // sticks
        (result: (item: "crafting_table", count: 1), pattern: ["##", "##"], key: {'#': (tag: "planks")}),  // crafting table
        (result: (item: "furnace", count: 1), pattern: ["###", "# #", "###"], key: {'#': (item: "cobblestone")}),  // furnace
        (result: (item: "chest", count: 1), pattern: ["###", "# #", "###"], key: {'#': (tag: "planks")}),  // chest
        (result: (item: "torch", count: 4), pattern: ["X", "#"], key: {'X': (item: "coal"), '#': (item: "stick")}),  // torch (coal)
        (result: (item: "torch", count: 4), pattern: ["X", "#"], key: {'X': (item: "charcoal"), '#': (item: "stick")}),  // torch (charcoal)
        // Tools and weapons
        (result: (item: "shield", count: 1), pattern: ["#X#", "###", " # "], key: {'#': (tag: "planks"), 'X': (item: "iron_ingot")}),  // shield (modern)
        (result: (item: "wooden_pickaxe", count: 1), pattern: ["XXX", " # ", " # "], key: {'X': (tag: "planks"), '#': (item: "stick")}),  // wood pickaxe
