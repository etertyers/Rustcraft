// 1.0.0's recipes for everything in scope (CraftingManager, FurnaceRecipes
// and TileEntityFurnace.getItemBurnTime).
//
// Ingredients are (item: name) or (tag: name), a tag being one of the groups
// below (any log, any wool, as 1.0.0 matched any data value). Items are
// named as in modern Minecraft; the recipes themselves are still 1.0.0's.
// Shaped recipes fit anywhere in the grid and may be mirrored.
//
// Left out, because their systems aren't in the game (see DECISIONS.md):
// redstone torch, repeater, lever, buttons, pressure plates, piston, sticky
// piston, dispenser, rails, powered and detector rails, minecarts, boat,
// fishing rod, map, painting, cake (no milk), enchanting table, brewing
// stand, cauldron, glass bottle, blaze powder, eye of ender, magma cream,
// fermented spider eye, glistering melon, nether brick blocks.
#![enable(implicit_some)]
(
    tags: {
        "logs": ["oak_log", "spruce_log", "birch_log"],
        "wool": ["white_wool", "orange_wool", "magenta_wool", "light_blue_wool", "yellow_wool", "lime_wool", "pink_wool", "gray_wool", "light_gray_wool", "cyan_wool", "purple_wool", "blue_wool", "brown_wool", "green_wool", "red_wool", "black_wool"],
    },
    shaped: [
        // Wood and basics
        (result: (item: "oak_planks", count: 4), pattern: ["#"], key: {'#': (tag: "logs")}),  // planks from any log
        (result: (item: "stick", count: 4), pattern: ["#", "#"], key: {'#': (item: "oak_planks")}),  // sticks
        (result: (item: "crafting_table", count: 1), pattern: ["##", "##"], key: {'#': (item: "oak_planks")}),  // crafting table
        (result: (item: "furnace", count: 1), pattern: ["###", "# #", "###"], key: {'#': (item: "cobblestone")}),  // furnace
        (result: (item: "chest", count: 1), pattern: ["###", "# #", "###"], key: {'#': (item: "oak_planks")}),  // chest
        (result: (item: "torch", count: 4), pattern: ["X", "#"], key: {'X': (item: "coal"), '#': (item: "stick")}),  // torch (coal)
        (result: (item: "torch", count: 4), pattern: ["X", "#"], key: {'X': (item: "charcoal"), '#': (item: "stick")}),  // torch (charcoal)
        // Tools and weapons
        (result: (item: "shield", count: 1), pattern: ["#X#", "###", " # "], key: {'#': (item: "oak_planks"), 'X': (item: "iron_ingot")}),  // shield (modern)
        (result: (item: "wooden_pickaxe", count: 1), pattern: ["XXX", " # ", " # "], key: {'X': (item: "oak_planks"), '#': (item: "stick")}),  // wood pickaxe
        (result: (item: "wooden_shovel", count: 1), pattern: ["X", "#", "#"], key: {'X': (item: "oak_planks"), '#': (item: "stick")}),  // wood shovel
        (result: (item: "wooden_axe", count: 1), pattern: ["XX", "X#", " #"], key: {'X': (item: "oak_planks"), '#': (item: "stick")}),  // wood axe
        (result: (item: "wooden_hoe", count: 1), pattern: ["XX", " #", " #"], key: {'X': (item: "oak_planks"), '#': (item: "stick")}),  // wood hoe
