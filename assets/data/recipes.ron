        (result: (item: "wooden_hoe", count: 1), pattern: ["XX", " #", " #"], key: {'X': (tag: "planks"), '#': (item: "stick")}),  // wood hoe
        (result: (item: "wooden_sword", count: 1), pattern: ["X", "X", "#"], key: {'X': (tag: "planks"), '#': (item: "stick")}),  // wood sword
